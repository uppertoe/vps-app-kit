{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests"],
  "minimumReleaseAge": "3 days",
  "postUpdateOptions": ["gomodTidy"],
  "customManagers": [
    {
      "description": "The images kitgate tests against, pinned by digest in Go constants.",
      "customType": "regex",
      "managerFilePatterns": ["/^cmd/kitgate/main\\.go$/"],
      "matchStrings": ["\"(?<depName>[a-z0-9./-]+):(?<currentValue>[A-Za-z0-9._-]+)@(?<currentDigest>sha256:[0-9a-f]{64})\""],
      "datasourceTemplate": "docker"
    }
  ]
}
